{
  "name": "socialstreamninja",
  "version": "0.3.52",
  "description": "Pac's Linux-focused Social Stream Ninja - forked from Steve",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdminPacman/social_stream_ninja.git"
  },
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "start2": "electron . --dev",
    "electron-rebuild": "electron-rebuild",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-builder --linux deb",
    "dist": "npm run build:linux"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.1",
    "@zerodytrash/tiktok-live-connector": "git+ssh://git@github.com/AdminPacman/TikTok-Live-Connector.git#ts-rewrite",
    "bufferutil": "^4.0.9",
    "color": "^5.0.0",
    "color-convert": "^3.0.1",
    "color-name": "^2.0.0",
    "electron-context-menu": "^3.6.1",
    "electron-fetch": "^1.9.1",
    "electron-is-dev": "^3.0.1",
    "electron-prompt": "^1.7.0",
    "electron-rebuild": "^3.2.9",
    "electron-store": "8.2.0",
    "es5-ext": "^0.10.64",
    "idb": "^8.0.2",
    "kokoro-js": "^1.2.0",
    "minimalist": "^1.0.0",
    "minimist": "^1.2.8",
    "onnxruntime-node": "1.21.0",
    "phonemizer": "^1.2.1",
    "sharp": "^0.33.5",
    "undici": "^6.21.2",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "app-builder-lib": "^24.13.3",
    "archiver": "^7.0.1",
    "electron": "^37.4.0",
    "electron-builder": "^24.13.3",
    "fs-extra": "^11.3.0",
    "jsonfile": "^6.1.0",
    "run-script-os-fix": "^1.0.4",
    "tsx": "^4.20.5"
  },
  "overrides": {
    "glob": "^10.3.10",
    "rimraf": "^5.0.7"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.33.5"
  },
  "build": {
    "appId": "com.socialstreamninja.app",
    "productName": "Social Stream Ninja",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!darwin/**/*",
      "!win32/**/*",
      "!**/*.icns",
      "!**/*.exe",
      "!**/dmg/**/*",
      "!**/nsis/**/*",
      "!**/win/**/*",
      "!**/mac/**/*",
      "!**/*.dmg",
      "!**/*.msi"
    ],
    "extraResources": [
      "assets/**/*"
    ],
    "linux": {
      "target": [
        {
          "type": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "desktop": {
        "Name": "Social Stream Ninja",
        "Comment": "Standalone app for social chat streams",
        "Categories": "Utility;AudioVideo;"
      }
    },
    "deb": {
      "compression": "xz",
      "depends": [
        "libvips42t64",
        "espeak-ng"
      ],
      "maintainer": "Pacman <adminpacman@example.com>",
      "vendor": "AdminPacman",
      "synopsis": "Social Stream Ninja for Linux",
      "fpm": [
        "--deb-priority=optional"
      ]
    }
  },
  "resolutions": {
    "undici": "6.19.8",
    "glob": "^10.3.10",
    "rimraf": "^5.0.7",
    "npmlog": "^7.0.1",
    "inflight": "1.0.6",
    "gauge": "^5.0.2",
    "are-we-there-yet": "^4.0.2",
    "@npmcli/move-file": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/AdminPacman/social_stream_ninja/issues"
  },
  "homepage": "https://github.com/AdminPacman/social_stream_ninja#readme"
}
